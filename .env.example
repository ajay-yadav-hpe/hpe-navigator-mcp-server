# HPE Navigator MCP Server - Environment Variables
# Copy this file to .env and fill in your credentials

# Authentication (at least one method required)
# Method 1: Username/Password (headless)
HPE_NAV_USERNAME=user@hpe.com
HPE_NAV_PASSWORD=

# Method 2: Pre-obtained service token (bypasses login)
# HPE_NAV_SERVICE_TOKEN=

# Optional: API endpoints (defaults shown)
# HPE_NAV_CXO_BASE_URL=https://web.service.cxo.suptools.hpecorp.net
# HPE_NAV_EXTRACTION_BASE_URL=https://extraction.service.cxo.suptools.hpecorp.net

# Optional: Okta configuration (for browser SSO fallback)
# HPE_NAV_OKTA_CLIENT_ID=0oa122o4eogCUhWbH698
# HPE_NAV_OKTA_AUTHORIZE_URL=https://mylogin.hpe.com/oauth2/aus5016946Vxb1HI6697/v1/authorize
# HPE_NAV_OKTA_TOKEN_URL=https://mylogin.hpe.com/oauth2/aus5016946Vxb1HI6697/v1/token
# HPE_NAV_CALLBACK_PORT=0

# Optional: Timeouts and limits
# HPE_NAV_TIMEOUT_MS=30000
# HPE_NAV_DOWNLOAD_TIMEOUT_MS=600000
# HPE_NAV_DOWNLOAD_DIR=./downloads
# HPE_NAV_MAX_DOWNLOAD_SIZE_MB=500
# HPE_NAV_TOKEN_REFRESH_BUFFER_MS=300000
